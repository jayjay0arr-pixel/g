{
  "name": "recall-rush",
  "version": "1.0.0",
  "private": true,
  "description": "Recall Rush: formula recall trainer, packaged as an Android app with Capacitor",
  "scripts": {
    "prepare-web": "node scripts/prepare-web.mjs",
    "android:add": "cap add android && node scripts/patch-android.mjs",
    "android:patch": "node scripts/patch-android.mjs",
    "android:check": "node scripts/patch-android.mjs --check",
    "assets:preview": "node scripts/make-assets.mjs --preview assets/preview",
    "sync": "npm run prepare-web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/clipboard": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@fontsource/caveat": "*",
    "@fontsource/doto": "*",
    "@fontsource/jetbrains-mono": "*",
    "@fontsource/roboto": "*",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1"
  },
  "engines": {
    "node": ">=20"
  }
}
